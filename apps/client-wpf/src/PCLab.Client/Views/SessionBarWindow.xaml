<Window x:Class="PCLab.Client.Views.SessionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Lab Session Bar"
        Width="430"
        Height="160"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Background="#0F172A"
        Loaded="Window_OnLoaded">
  <Border CornerRadius="16"
          BorderBrush="#1E293B"
          BorderThickness="1"
          Padding="18">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="{Binding StudentName}"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding StudentId}"
                   Foreground="#CBD5E1"
                   FontSize="14" />
        <TextBlock Margin="0,12,0,0"
                   Text="{Binding StartedAtText}"
                   Foreground="#93C5FD"
                   FontSize="13" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
          <TextBlock Text="{Binding ElapsedText}"
                     Foreground="#E2E8F0"
                     FontSize="14"
                     FontWeight="Bold" />
          <TextBlock Margin="14,0,0,0"
                     Text="{Binding IdleText}"
                     Foreground="#E2E8F0"
                     FontSize="14" />
        </StackPanel>
      </StackPanel>

      <Button Grid.Column="1"
              Margin="20,0,0,0"
              Padding="16,10"
              VerticalAlignment="Center"
              Command="{Binding LogoutCommand}"
              Background="#DC2626"
              Foreground="White"
              FontSize="14"
              FontWeight="Bold"
              Content="End Session" />
    </Grid>
  </Border>
</Window>
